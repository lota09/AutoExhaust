/*
  ESP32-C6 Bambu Lab X1C Auto Exhaust System (Final)

  기능:
  - WiFi 및 MQTTS 연결
  - 뱀부랩 X1C 상태 모니터링
  - 출력이 시작되면(RUNNING) 릴레이 ON -> 배기 팬 가동
  - 출력이 끝나면(FINISH/IDLE) 릴레이 OFF -> 배기 팬 정지
*/

#include <ArduinoJson.h>
#include <PubSubClient.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>

// ==========================================
// [설정 구역] 사용자 환경에 맞게 수정하세요
// ==========================================
const char *target_ssid = "TUF-AX5400-D510"; // 와이파이 이름
const char *target_password = "YOUR_WIFI_PASSWORD";    // 와이파이 비밀번호

const char *mqtt_server = "192.168.50.209"; // 프린터 IP 주소 (ui.txt)
const int mqtt_port = 8883;                 // MQTTS 포트
const char *mqtt_user = "bblp";             // 고정값
const char *mqtt_pass = "YOUR_ACCESS_CODE";         // 프린터 LAN Access Code (8자리)

const char *printer_serial = "YOUR_PRINTER_SN"; // ui.txt에 있던 시리얼 번호
// ==========================================

// 릴레이 제어 핀 (ESP32-C6 DevKit 내부 LED와 공유될 수 있음)
const int RELAY_PIN = 2;

// [옵션] 팬 끄기 지연 시간 (출력 완료 후 잔류 가스 배출용, 단위: ms)
// 예: 60000 = 1분 지연
const unsigned long FAN_OFF_DELAY = 10000;
// ==========================================

char mqtt_topic_report[64];
WiFiClientSecure askClient;
PubSubClient client(askClient);
DynamicJsonDocument doc(30720);

// 상태 관리 변수
bool isPrinting = false;
unsigned long finishTime = 0; // 출력 완료 시점 기록
bool waitingTurnOff = false;  // 지연 끄기 대기 중인지 여부

void setup_wifi() {
  delay(10);
  Serial.print("WiFi Connecting: ");
  Serial.println(target_ssid);
  WiFi.mode(WIFI_STA);
  WiFi.begin(target_ssid, target_password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected.");
}

// 릴레이 제어 함수
void controlFan(bool state) {
  if (state) {
    digitalWrite(RELAY_PIN,
                 HIGH); // 릴레이 ON (모듈에 따라 LOW Trigger일 수도 있음)
    Serial.println(">>> [FAN SYSTEM] FAN ON <<<");
  } else {
    digitalWrite(RELAY_PIN, LOW); // 릴레이 OFF
    Serial.println(">>> [FAN SYSTEM] FAN OFF <<<");
  }
}

void callback(char *topic, byte *payload, unsigned int length) {
  DeserializationError error = deserializeJson(doc, payload, length);
  if (error) {
    Serial.println("JSON Parse Error");
    return;
  }
  if (!doc.containsKey("print"))
    return;

  JsonObject printData = doc["print"];
  const char *state = printData["gcode_state"] | "UNKNOWN";

  // 상태 모니터링 로그
  Serial.printf("[Status] %s | Temp: N:%.1f B:%.1f\n", state,
                (float)printData["nozzle_temper"],
                (float)printData["bed_temper"]);

  // --- 로직 판단 ---
  // 상태가 RUNNING이거나 PAUSE(일시정지 중에도 팬은 계속 돌아야 함)일 때
  if (strcmp(state, "RUNNING") == 0 || strcmp(state, "PAUSE") == 0) {
    if (!isPrinting) {
      isPrinting = true;
      waitingTurnOff = false;
      controlFan(true); // 팬 즉시 가동
    }
    // 출력 중에는 지연 타이머 초기화
    waitingTurnOff = false;
  } else {
    // 출력이 아님 (IDLE, FINISH, PREPARE 등)
    if (isPrinting) {
      // 방금 끝남 -> 지연 타이머 시작
      isPrinting = false;
      waitingTurnOff = true;
      finishTime = millis();
      Serial.println(">>> Print Finished. Cooling down... (Delay Timer Start)");
    }
  }
}

void reconnect() {
  while (!client.connected()) {
    Serial.print("MQTT Connecting...");
    String clientId = "ESP32FAN-";
    clientId += String(random(0xffff), HEX);
    askClient.setInsecure();

    if (client.connect(clientId.c_str(), mqtt_user, mqtt_pass)) {
      Serial.println("Done.");
      sprintf(mqtt_topic_report, "device/%s/report", printer_serial);
      client.subscribe(mqtt_topic_report);
    } else {
      Serial.print("Fail rc=");
      Serial.print(client.state());
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);

  // 릴레이 핀 설정
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW); // 초기 상태 OFF

  setup_wifi();

  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
  client.setBufferSize(20480); // 버퍼 필수 증대
}

void loop() {
  if (!client.connected())
    reconnect();
  client.loop();

  // 지연 끄기 로직
  if (waitingTurnOff) {
    if (millis() - finishTime > FAN_OFF_DELAY) {
      waitingTurnOff = false;
      controlFan(false); // 지연 시간 경과 후 팬 끄기
      Serial.println(">>> Cool down complete. Fan OFF.");
    }
  }
}
